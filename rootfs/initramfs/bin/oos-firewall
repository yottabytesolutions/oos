#!/bin/sh
# Copyright (C) 2026 OOS contributors
# SPDX-License-Identifier: GPL-2.0-or-later
# oos-firewall: inbound only from the prefixes of `net.allow` (oos-conf, docs/network.md 6), before any service of
# the image listens. Loopback, answers to what the scope sent (DHCP, DNS, NTP) and IPv6 neighbour discovery always
# pass; everything else that comes in is dropped. Outbound is not limited. No `net.allow` or an empty one: no firewall,
# as before (a table loaded before is removed). A list of which nothing parses closes everything but loopback rather
# than opening it, and so does a ruleset nft refuses (an entry the checks here let through): a typo in the list must
# not open the scope.
# `onlink` admits IPv4 connected subnets; `onlink6` admits the IPv6 prefixes on the link: the routes without a gateway the kernel made
# from the router's advertisements, /48 to /128, not fe80::/64 (a shorter one, `2000::/3` from a rogue router, would
# open the scope to the internet). They change with the provider: `watch` checks them every 10 s, puts them in the
# nft sets and in /tmp/oos-net4.prefixes and /tmp/oos-net6.prefixes for oos-ui (netacl.rs, net6.rs). busybox ip has no monitor.
#   oos-firewall             apply (rcS)
#   oos-firewall watch       keep the on-link sets up to date (rcS, in the background; its pid in $WPID)
#   oos-firewall reload      oos-ui after a change of `net.allow` (Remote services > Allowed): the watcher of the old
#                            list stopped, the list applied, a watcher started as rcS starts it. Without a list the
#                            scope is left as a start without one leaves it: no table, no watcher, no prefix file
#   oos-firewall --print     print the ruleset only (host tests: OOS_CONF_FILES, OOS_ROUTES6 = a file in place of
#                            `ip -6 route show`)
#   oos-firewall --prefixes  print the prefixes on the link only
allow=$("$(dirname "$0")/oos-conf" net.allow)
log() { echo "oos-firewall: $*" >&2; [ ! -w /dev/kmsg ] || echo "oos-firewall: $*" > /dev/kmsg; }
PFX=/tmp/oos-net6.prefixes
WPID=/tmp/oos-firewall-watch.pid
prefixes() {
	{ if [ -n "${OOS_ROUTES6:-}" ]; then cat "$OOS_ROUTES6"; else ip -6 route show 2>/dev/null; fi; } | awk '
		$1 ~ /^[0-9A-Fa-f:]+\/[0-9]+$/ && $2 == "dev" && $3 != "lo" {
			p = tolower($1); n = substr(p, index(p, "/") + 1) + 0
			if (n < 48 || n > 128 || p ~ /^(fe[89ab]|ff)/) next
			print p
		}' | sort -u
}
prefixes4() {
    { if [ -n "${OOS_ROUTES4:-}" ]; then cat "$OOS_ROUTES4"; else ip -4 route show 2>/dev/null; fi; } | awk '
        $1 ~ /^[0-9.]+\/[0-9]+$/ && $2 == "dev" && $3 != "lo" && / proto kernel / && / scope link / {
            n = substr($1, index($1, "/") + 1) + 0
            if (n > 0 && n <= 32) print $1
        }' | sort -u
}
if [ "${1:-}" = --prefixes ]; then prefixes; exit 0; fi
if [ "${1:-}" = reload ]; then
	# the watcher knows the list it started with only; a pid of another program is left alone
	p=$(cat $WPID 2>/dev/null)
	[ -n "$p" ] && [ "$(cat /proc/"$p"/comm 2>/dev/null)" = oos-firewall ] && kill "$p" 2>/dev/null
	rm -f $WPID
	"$0"; r=$?
	# ends at once without either on-link token in the list
	(setsid "$0" watch < /dev/null > /dev/null &)
	exit $r
fi
if [ -z "$allow" ]; then
	case "${1:-}" in --print | watch) exit 0;; esac
	rm -f $PFX /tmp/oos-net4.prefixes
	# what a start without the key leaves: no table (none at power-on, the one of an earlier list after a reload)
	if [ -x /bin/nft ] && /bin/nft list table inet oos_fw > /dev/null 2>&1; then
		/bin/nft delete table inet oos_fw || { log "nft did not remove the firewall"; exit 1; }
		log "no net.allow: firewall removed, inbound open"
	fi
	exit 0
fi
v4=; v6=; bad=; on6=; on4=
octet() { case "$1" in ''|*[!0-9]*) return 1;; esac; [ "$1" -le 255 ]; }
# IPv6: groups of 1 to 4 hex digits, eight of them or fewer with one `::` (`2001:db8:::1` made nft refuse everything)
v6ok() {
	echo "$1" | awk -F: '{
		d = gsub(/::/, "&"); if (d > 1 || $0 ~ /:::/) exit 1
		n = 0
		for (i = 1; i <= NF; i++) { if ($i == "") continue; if ($i !~ /^[0-9A-Fa-f]+$/ || length($i) > 4) exit 1; n++ }
		if (d ? n > 7 : n != 8) exit 1
	}'
}
for w in $(echo "$allow" | tr ',' ' '); do
	# `a/` with nothing after the slash is no prefix length (nft refused the ruleset for it)
	a=${w%%/*}; n=; case "$w" in */*) n=${w#*/}; [ -n "$n" ] || n=none;; esac
	case "$a" in
	onlink) on4=1;;
	onlink6) on6=1;;
	*:*)
		if v6ok "$a" && { [ -z "$n" ] || { echo "$n" | grep -Eq '^[0-9]+$' && [ "$n" -le 128 ]; }; }; then
			v6="$v6${v6:+, }$w"
		else bad="$bad $w"; fi;;
	*)
		IFS=. read -r o1 o2 o3 o4 rest <<-X
		$a
		X
		if [ -z "$rest" ] && octet "$o1" && octet "$o2" && octet "$o3" && octet "$o4" && { [ -z "$n" ] || { echo "$n" | grep -Eq '^[0-9]+$' && [ "$n" -le 32 ]; }; }; then
			v4="$v4${v4:+, }$w"
		else bad="$bad $w"; fi;;
	esac
done
[ -n "$bad" ] && log "net.allow: left out:$bad"
[ -z "$v4$v6$on6$on4" ] && log "net.allow names nothing usable: inbound closed except loopback"
# the prefixes as an nft list, `a/64, b/56`
list() { echo $1 | sed 's/ /, /g'; }
p4=; p6=
[ -n "$on4" ] && p4=$(prefixes4)
[ -n "$on6" ] && p6=$(prefixes)
rules() {
	echo "table inet oos_fw"
	echo "delete table inet oos_fw"
	echo "table inet oos_fw {"
    for family in 4 6; do
        if [ "$family" = 4 ]; then enabled=$on4; name=onlink; addr=ipv4_addr; p=$p4
        else enabled=$on6; name=onlink6; addr=ipv6_addr; p=$p6; fi
        [ -n "$enabled" ] || continue
        echo "	set $name {"
        echo "		type $addr; flags interval; auto-merge"
        [ -z "$p" ] || echo "		elements = { $(list "$p") }"
        echo "	}"
    done
	echo "	chain input {"
	echo "		type filter hook input priority filter; policy drop;"
	echo "		iif lo accept"
	case "$("$(dirname "$0")/oos-conf" remote.hislip)" in
		on|true|1) ;;
		*) echo "		tcp dport 4880 drop";;
	esac
	echo "		ct state established,related accept"
	echo "		ct state invalid drop"
	echo "		icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-advert } ip6 hoplimit 255 accept"
	# the DHCP client before it has an address (udhcpc reads on a raw socket, this is for its later renewals)
	echo "		udp sport 67 udp dport 68 accept"
	[ -n "$v4" ] && echo "		ip saddr { $v4 } accept"
	[ -n "$v6" ] && echo "		ip6 saddr { $v6 } accept"
	[ -n "$on6" ] && echo "		ip6 saddr @onlink6 accept"
	[ -n "$on4" ] && echo "		ip saddr @onlink accept"
	echo "	}"
	echo "}"
}
if [ "${1:-}" = --print ]; then rules; exit 0; fi
[ -x /bin/nft ] || { log "no /bin/nft in this image: NO firewall"; exit 1; }
keep() { printf '%s\n' $1 > "$2.new" && mv "$2.new" "$2"; }
if [ "${1:-}" = watch ]; then
    [ -n "$on4$on6" ] || exit 0
    echo $$ > $WPID
    while :; do
        sleep "${OOS_FW6_PERIOD:-10}"
        for family in 4 6; do
            if [ "$family" = 4 ]; then enabled=$on4; name=onlink; new=$(prefixes4)
            else enabled=$on6; name=onlink6; new=$(prefixes); fi
            [ -n "$enabled" ] || continue
            file=/tmp/oos-net$family.prefixes
            [ "$new" != "$(cat "$file" 2>/dev/null)" ] || continue
            { echo "flush set inet oos_fw $name"; [ -z "$new" ] || echo "add element inet oos_fw $name { $(list "$new") }"; } > /tmp/oos-firewall-prefixes.nft
            if /bin/nft -f /tmp/oos-firewall-prefixes.nft; then
                keep "$new" "$file"
                log "IPv$family prefixes on the link: $(list "${new:-none}")"
            else log "nft refused the IPv$family prefixes"; fi
        done
    done
fi
rules > /tmp/oos-firewall.nft
if /bin/nft -f /tmp/oos-firewall.nft; then
    if [ -n "$on4" ]; then keep "$p4" /tmp/oos-net4.prefixes; else rm -f /tmp/oos-net4.prefixes; fi
    if [ -n "$on6" ]; then keep "$p6" "$PFX"; else rm -f "$PFX"; fi
    log "inbound only from $allow"
else
	# closed rather than open: loopback only, as for a list of which nothing parses
	log "nft refused the ruleset (/tmp/oos-firewall.nft): inbound closed except loopback"
	v4=; v6=; on6=; on4=
	rules > /tmp/oos-firewall-closed.nft
	/bin/nft -f /tmp/oos-firewall-closed.nft || log "nft refused the closed ruleset too: NO firewall"
	exit 1
fi
