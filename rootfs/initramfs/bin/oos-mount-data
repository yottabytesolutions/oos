#!/bin/sh
# Copyright (C) 2026 Julian Decker
# SPDX-License-Identifier: GPL-2.0-or-later
# OOS's own data partition (own calibration, setups, pictures) at /oos: the last 16 MiB of the stock `backup`
# partition (where exactly: /etc/oos-board). Android does not use
# `backup`; U-Boot's fallback only reads the image header at its start, where a stock fallback image may live. The
# PARM table stays untouched: only the OOS kernel sees the area, as mmcblk0p1 from `blkdevparts=` in the DTB bootargs,
# so the kernel keeps every write inside these 16 MiB.
# First use creates a journaled "oosdata" filesystem. Existing filesystems are checked before mounting.
. "${OOS_BOARD_FILE:-/etc/oos-board}"
[ ! -e /tmp/oos-data.closing ] || { echo "oos-mount-data: /oos is closed for shutdown" >&2; exit 1; }
P=/dev/mmcblk0p1
S=/sys/class/block/mmcblk0p1
stock_confirmed=${1:-0}
grep -q ' /oos ext4 ' /proc/mounts && exit 0
notice() {
	printf '%s\n' "$1" > /tmp/oos-data.notice
	printf '%s\n' "$1"
	[ ! -w /dev/kmsg ] || printf 'oos-mount-data: %s\n' "$1" > /dev/kmsg
}
unavailable() {
	echo "oos-mount-data: $1"
	if [ "$stock_confirmed" = 1 ]; then
		next="Power-cycle to start stock Android."
	else
		next="Next start unknown. To select stock Android, run oos-oneshot successfully, then power-cycle."
	fi
	notice "The data area is unavailable. Saved settings and the calibration copy are unavailable. Network identity is temporary for this start. $next Save /tmp/oos-data.log and contact support before changing the card."
	exit 1
}
[ -b $P ] || unavailable "no $P (blkdevparts missing from the command line?)"
[ "$(cat $S/start)" = "$OOS_OOSDATA_LBA" ] && [ "$(cat $S/size)" = "$OOS_OOSDATA_SECTORS" ] ||
	unavailable "$P is not LBA $OOS_OOSDATA_LBA + $OOS_OOSDATA_SECTORS"
# Reconcile a regular image, including any journal replay, before mounting the checked data.
repair=$(oos-update storage-data --card /dev/mmcblk0) || unavailable "data preparation failed"
mkdir -p /oos || unavailable "could not create the mount point"
# Keep the underlying directory read-only across unmount and recovery.
grep -q '^oos-base /oos tmpfs ro[, ]' /proc/mounts ||
	mount -t tmpfs -o ro oos-base /oos || unavailable "could not protect the mount point"
if ! mount -t ext4 -o noatime $P /oos; then
	# Leave the boot-time fallback directory available for a temporary network identity.
	umount /oos || echo "oos-mount-data: could not remove the unused read-only mount"
	unavailable "mount failed"
fi
[ -z "$repair" ] || notice "$repair"
oos-update storage-data clean-recovered || echo "oos-mount-data: could not finish inspecting lost+found"
mkdir -p /oos/cal /oos/setups /oos/shots
echo "oos-mount-data: $P on /oos ($(df -h /oos | tail -1 | awk '{print $4}') free)"
