#!/bin/sh
# Copyright (C) 2026 Julian Decker
# SPDX-License-Identifier: GPL-2.0-or-later
# One-shot return to stock. The stock loader (Rigol U-Boot 2014.10, 2024-08-29) boots `boot`; when the image in `boot`
# fails its check it tries `recovery` (this OOS image), then `backup`. OOS is selected by replacing the magic "KRNL" at
# the start of `boot` with "OOSK"; this script puts "KRNL" back so the next power-on boots stock Android.
# misc/BCB stays untouched under ADR 0011.
# Checks first that the device is the board's SD card and that its PARM table has the stock layout (/etc/oos-board).
. "${OOS_BOARD_FILE:-/etc/oos-board}"
dev=${OOS_DEV:-/dev/mmcblk0}
log=${OOS_LOG:-/dev/kmsg}
BOOT_LBA=$OOS_BOOT_LBA
for i in $(seq 1 50); do { [ -b $dev ] || [ -f $dev ]; } && break; sleep 0.2; done
{ [ -b $dev ] || [ -f $dev ]; } || { echo "oos-oneshot: no $dev" > $log; exit 1; }
[ -n "${OOS_TEST:-}" ] || readlink -f /sys/block/mmcblk0/device | grep -q "$OOS_CARD_CONTROLLER" || { echo "oos-oneshot: mmcblk0 is not the SD card, skipped" > $log; exit 1; }
parm=$(dd if=$dev bs=512 skip=$OOS_PARM_LBA count=2 2>/dev/null | tr -d '\000' | tr 'A-F' 'a-f')
case "$parm" in
	P[Aa]RM*) ;;
	*) echo "oos-oneshot: unexpected partition table, skipped" > $log; exit 1;;
esac
for mark in $OOS_PARM_MARKS; do
	case "$parm" in
		*"$mark"*) ;;
		*) echo "oos-oneshot: unexpected partition table, skipped" > $log; exit 1;;
	esac
done
magic=$(dd if=$dev bs=512 skip=$BOOT_LBA count=1 2>/dev/null | head -c 4)
case "$magic" in
	OOSK)
        printf KRNL | oos-update storage-write boot "$((BOOT_LBA * 512))" --card "$dev" --execute \
            || { echo "oos-oneshot: RESTORE write or verification FAILED" > "$log"; exit 1; }
        sync || { echo "oos-oneshot: RESTORE sync FAILED" > "$log"; exit 1; }
        now=$(dd if=$dev bs=512 skip=$BOOT_LBA count=1 iflag=direct 2>/dev/null | head -c 4)
        [ "$now" = KRNL ] || { echo "oos-oneshot: RESTORE FAILED ($now)" > "$log"; exit 1; }
		echo "oos-oneshot: boot magic restored, next power-on boots stock" > $log;;
	KRNL) echo "oos-oneshot: boot already valid (stock boots next time)" > $log;;
	*) echo "oos-oneshot: unexpected boot magic '$magic', left alone" > $log; exit 1;;
esac

exit 0
