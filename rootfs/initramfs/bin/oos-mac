#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# Device identity: saved address, board storage, then the RK3399 CPU id. No image input or randomness.
set -eu
here=$(dirname "$0")
conf=${OOS_DEVICE_CONF:-/oos/system.conf}
ok() {
	echo "$1" | grep -Eq '^[0-9A-Fa-f]{2}(:[0-9A-Fa-f]{2}){5}$' || return 1
	[ $((0x${1%%:*} & 1)) -eq 0 ] && [ "$(echo "$1" | tr -d ':0')" != "" ]
}
legacy_cid() {
    cid=$(cat "${OOS_CID_FILE:-/sys/block/mmcblk0/device/cid}" 2>/dev/null) || return 1
    [ -n "$cid" ] || return 1
    h=$(echo "$cid" | md5sum | cut -c1-10)
    echo "02:$(echo "$h" | sed 's/../&:/g; s/:$//')"
}
want=$(OOS_CONF_FILES="$conf" "$here/oos-conf" eth.mac)
case "$want" in
cid) legacy_cid; exit;;
vendor) mac=$("$here/oos-board" mac 2>/dev/null) || mac=
        if ok "$mac"; then echo "$mac"; else legacy_cid; fi; exit;;
'') ;;
*) ok "$want" || { echo "oos-mac: invalid saved eth.mac" >&2; exit 1; }
   echo "$want"; exit 0;;
esac
mac=$("$here/oos-board" mac 2>/dev/null) || mac=
if ! ok "$mac"; then
	id=$(sed -n 's/^Serial[ 	]*:[ 	]*//p' "${OOS_CPUINFO:-/proc/cpuinfo}" 2>/dev/null) || id=
	if ! echo "$id" | grep -Eq '^[0-9a-fA-F]{16}$' || [ -z "$(echo "$id" | tr -d 0)" ]; then
		id=$(od -An -tx1 -j7 -N16 "${OOS_CPU_NVMEM:-/sys/bus/nvmem/devices/rockchip-efuse0/nvmem}" 2>/dev/null | tr -d ' \n') || id=
        echo "$id" | grep -Eq '^[0-9a-fA-F]{32}$' || id=
	fi
	[ -n "$id" ] && [ -n "$(echo "$id" | tr -d 0)" ] || { echo "oos-mac: no hardware MAC or CPU id" >&2; exit 1; }
	h=$(printf '%s' "$id" | tr A-F a-f | sha256sum | cut -c1-10)
	mac="02:$(echo "$h" | sed 's/../&:/g; s/:$//')"
fi
# Only fill an absent key. Existing settings, including legacy selectors, are never rewritten.
if [ "$(OOS_CONF_FILES="$conf" "$here/oos-conf" eth.mac __absent__)" = __absent__ ]; then
	[ ! -e /tmp/oos-data.closing ] || { echo "oos-mac: /oos is closed for shutdown" >&2; exit 1; }
	dir=$(dirname "$conf")
	mkdir -p "$dir"
	umask 077
	{
		if [ -e "$conf" ]; then cat "$conf"
		else printf '# OOS device identity and system overrides. Kept across updates.\n'; fi
		printf '\neth.mac = %s\n' "$mac"
	} > "$conf.new"
	sync "$conf.new"
	mv "$conf.new" "$conf"
	sync "$dir"
fi
echo "$mac"
